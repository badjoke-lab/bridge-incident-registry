---
import { attackVectorCategories, currentOutcomes, incidentTypes, recoveryStatuses, reimbursementStatuses, restartStatuses } from "../lib/enums";
import { formatLabel } from "../lib/format";

interface Props { disabled?: boolean; }
const { disabled = false } = Astro.props;
---
<form class="registry-toolbar" id="incident-filters" aria-label="Incident registry filters">
  <div class="registry-field registry-search-field"><label for="incident-search">Search</label><input id="incident-search" name="search" type="search" placeholder="Incident, bridge, chain, asset, or attack category" autocomplete="off" disabled={disabled} /></div>
  <div class="registry-field"><label for="incident-type">Type</label><select id="incident-type" name="type" disabled={disabled}><option value="">All types</option>{incidentTypes.map((type) => <option value={type}>{formatLabel(type)}</option>)}</select></div>
  <div class="registry-field"><label for="incident-attack">Attack category</label><select id="incident-attack" name="attack" disabled={disabled}><option value="">All attack categories</option>{attackVectorCategories.map((category) => <option value={category}>{formatLabel(category)}</option>)}</select></div>
  <div class="registry-field"><label for="incident-recovery">Recovery</label><select id="incident-recovery" name="recovery" disabled={disabled}><option value="">All recovery states</option>{recoveryStatuses.map((status) => <option value={status}>{formatLabel(status)}</option>)}</select></div>
  <div class="registry-field"><label for="incident-reimbursement">Reimbursement</label><select id="incident-reimbursement" name="reimbursement" disabled={disabled}><option value="">All reimbursement states</option>{reimbursementStatuses.map((status) => <option value={status}>{formatLabel(status)}</option>)}</select></div>
  <div class="registry-field"><label for="incident-restart">Restart</label><select id="incident-restart" name="restart" disabled={disabled}><option value="">All restart states</option>{restartStatuses.map((status) => <option value={status}>{formatLabel(status)}</option>)}</select></div>
  <div class="registry-field"><label for="incident-outcome">Outcome</label><select id="incident-outcome" name="outcome" disabled={disabled}><option value="">All outcomes</option>{currentOutcomes.map((outcome) => <option value={outcome}>{formatLabel(outcome)}</option>)}</select></div>
  <div class="registry-field"><label for="incident-unresolved">Resolution</label><select id="incident-unresolved" name="unresolved" disabled={disabled}><option value="">All</option><option value="true">Unresolved</option><option value="false">Resolved / final outcome known</option></select></div>
  <div class="registry-field"><label for="incident-date-from">Date from</label><input id="incident-date-from" name="date_from" type="date" disabled={disabled} /></div>
  <div class="registry-field"><label for="incident-date-to">Date to</label><input id="incident-date-to" name="date_to" type="date" disabled={disabled} /></div>
  <div class="registry-field"><label for="incident-loss">Reported loss</label><select id="incident-loss" name="loss" disabled={disabled}><option value="">All amounts</option><option value="known">Known amount</option><option value="1000000">$1M or more</option><option value="10000000">$10M or more</option><option value="100000000">$100M or more</option></select></div>
  <div class="registry-field"><label for="incident-sort">Sort</label><select id="incident-sort" name="sort" disabled={disabled}><option value="date-desc">Newest incident</option><option value="loss-desc">Reported loss high first</option><option value="reviewed-desc">Recently reviewed</option><option value="name-asc">Title A–Z</option></select></div>
  <button class="registry-reset" type="reset" disabled={disabled}>Reset</button>
</form>

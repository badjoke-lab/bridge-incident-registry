---
interface Props {
  kicker?: string;
  title: string;
  description?: string;
}

const { kicker, title, description } = Astro.props;
---
<header class="section-header">
  <div>
    {kicker && <div class="section-kicker">{kicker}</div>}
    <h2>{title}</h2>
    {description && <p>{description}</p>}
  </div>
</header>

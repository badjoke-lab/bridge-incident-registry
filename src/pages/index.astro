---
import BaseLayout from "../layouts/BaseLayout.astro";
import Callout from "../components/Callout.astro";
import MaturityChip from "../components/MaturityChip.astro";
import SectionHeader from "../components/SectionHeader.astro";
import StatusChip from "../components/StatusChip.astro";
import UpdateStatusChip from "../components/UpdateStatusChip.astro";
import { getRegistryCounts } from "../lib/data";

const counts = getRegistryCounts();
const hasRegistryData = counts.bridges > 0 || counts.incidents > 0 || counts.events > 0 || counts.evidence > 0;
---
<BaseLayout
  title="Bridge Incident Registry"
  description="A historical registry of cross-chain bridge incidents, pauses, recoveries, reimbursements, and migrations."
>
  <section class="hero">
    <div class="kicker">Quiet incident registry</div>
    <h1>The registry for what happened after cross-chain bridge incidents.</h1>
    <p class="lede">
      Most hack databases stop at the exploit. Bridge Incident Registry tracks what happened after:
      pauses, recoveries, reimbursements, reopenings, migrations, and shutdowns.
    </p>
  </section>

  <section class="summary-strip" aria-label="Registry record summary">
    <div class="stat">
      <div class="stat-value">{counts.bridges}</div>
      <div class="stat-label">Bridge records</div>
    </div>
    <div class="stat">
      <div class="stat-value">{counts.incidents}</div>
      <div class="stat-label">Incident cases</div>
    </div>
    <div class="stat">
      <div class="stat-value">{counts.events}</div>
      <div class="stat-label">Timeline events</div>
    </div>
    <div class="stat">
      <div class="stat-value">{counts.evidence}</div>
      <div class="stat-label">Evidence records</div>
    </div>
  </section>

  <SectionHeader
    kicker="Foundation"
    title="Registry primitives before registry data"
    description="The first UI components establish status, maturity, freshness, callout, and empty-state patterns before canonical JSON records are added."
  />

  <div class="chip-row" aria-label="Sample registry chips">
    <StatusChip status="active" />
    <StatusChip status="paused" />
    <StatusChip status="migrated" />
    <MaturityChip maturity="reviewed" />
    <UpdateStatusChip status="current" />
  </div>

  <section class="panel-grid" aria-label="Registry focus">
    <article class="panel">
      <h2>Incident aftermath</h2>
      <p>Track pause, recovery, reimbursement, reopening, migration, and shutdown outcomes.</p>
    </article>
    <article class="panel">
      <h2>Evidence-first records</h2>
      <p>Every major claim should point back to official, archival, analytical, or journalistic evidence.</p>
    </article>
    <article class="panel">
      <h2>Not a safety ranking</h2>
      <p>BIR records historical incidents and outcomes. It does not recommend bridges or rank safety.</p>
    </article>
  </section>

  {!hasRegistryData && (
    <Callout title="Static foundation only">
      The canonical registry is currently empty. Bridge, incident, event, and evidence records will appear here automatically after reviewed JSON records are merged.
    </Callout>
  )}
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Callout from "../components/Callout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { getRegistryCounts, registryData } from "../lib/data";

const counts = getRegistryCounts();
const hasRegistryData = Object.values(counts).some((count) => count > 0);
const latestVerifiedAt = [
  ...registryData.bridges.map((record) => record.last_verified_at),
  ...registryData.incidents.map((record) => record.last_verified_at)
].filter(Boolean).sort().at(-1);
const site = Astro.site ?? new URL("https://bir.badjoke-lab.com");
const datasetJsonLd = {
  "@type": "Dataset",
  "@id": new URL("/#dataset", site).toString(),
  name: "Bridge Incident Registry canonical datasets",
  description: "Canonical bridge, incident, event, and evidence records for historical cross-chain incident research.",
  url: new URL("/", site).toString(),
  dateModified: latestVerifiedAt,
  isAccessibleForFree: true,
  license: "https://creativecommons.org/licenses/by/4.0/",
  creator: { "@type": "Organization", name: "BadJoke-Lab", url: "https://badjoke-lab.com/" },
  distribution: [
    { "@type": "DataDownload", encodingFormat: "application/json", contentUrl: new URL("/data/bridges.json", site).toString() },
    { "@type": "DataDownload", encodingFormat: "application/json", contentUrl: new URL("/data/incidents.json", site).toString() },
    { "@type": "DataDownload", encodingFormat: "application/json", contentUrl: new URL("/data/events.json", site).toString() },
    { "@type": "DataDownload", encodingFormat: "application/json", contentUrl: new URL("/data/evidence.json", site).toString() }
  ]
};
---
<BaseLayout
  title="Bridge Incident Registry — Cross-chain incident history"
  description="A historical registry of cross-chain bridge incidents, pauses, recoveries, reimbursements, reopenings, migrations, and shutdowns."
  alternateDataPath="/data/manifest.json"
  dateModified={latestVerifiedAt}
  jsonLd={datasetJsonLd}
>
  <section class="hero">
    <div class="kicker">Cross-chain incident history</div>
    <h1>The registry for what happened after bridge incidents.</h1>
    <p class="lede">
      Bridge Incident Registry connects bridge records with exploit cases, pauses, recoveries,
      reimbursements, reopenings, migrations, shutdowns, and the evidence behind each claim.
    </p>
  </section>

  <section class="summary-strip" aria-label="Registry record summary">
    <div class="stat"><div class="stat-value">{counts.bridges}</div><div class="stat-label">Bridge records</div></div>
    <div class="stat"><div class="stat-value">{counts.incidents}</div><div class="stat-label">Incident cases</div></div>
    <div class="stat"><div class="stat-value">{counts.events}</div><div class="stat-label">Timeline events</div></div>
    <div class="stat"><div class="stat-value">{counts.evidence}</div><div class="stat-label">Evidence records</div></div>
  </section>

  <SectionHeader
    kicker="Reviewed registry"
    title="Explore bridges, incidents, and their aftermath"
    description="Start with a bridge entity, open an incident case, or review how the registry handles dates, loss figures, recovery, reimbursement, and unresolved outcomes."
  />

  <div class="panel-grid" aria-label="Registry entry points">
    <article class="panel">
      <h2><a href="/bridges/">Bridge records</a></h2>
      <p>Browse canonical bridge entities, operating status, connected chains and assets, incident history, and evidence coverage.</p>
    </article>
    <article class="panel">
      <h2><a href="/incidents/">Incident cases</a></h2>
      <p>Review exploit dates, reported losses, affected systems, recovery and reimbursement status, restarts, migrations, and final outcomes.</p>
    </article>
    <article class="panel">
      <h2><a href="/methodology/">Methodology</a></h2>
      <p>Read the inclusion rules, evidence hierarchy, date precision, confidence boundaries, and treatment of unknown or disputed facts.</p>
    </article>
  </div>

  <SectionHeader
    kicker="Research scope"
    title="The incident is the start of the record, not the end"
    description="The registry follows material changes after the initial event instead of reducing each case to a single loss figure."
  />

  <div class="panel-grid" aria-label="Registry research scope">
    <article class="panel"><h2>Operational response</h2><p>Pauses, emergency controls, validator or relayer changes, contract upgrades, and staged reopenings.</p></article>
    <article class="panel"><h2>Customer and protocol outcome</h2><p>Recoveries, reimbursements, claim processes, recapitalization, migration, abandonment, and unresolved losses.</p></article>
    <article class="panel"><h2>Evidence and uncertainty</h2><p>Source-linked claims, explicit date precision, confidence labels, known unknowns, and later corrections.</p></article>
  </div>

  {!hasRegistryData && (
    <Callout title="No reviewed records published">
      Canonical bridge, incident, event, and evidence records will appear after reviewed JSON records are merged.
    </Callout>
  )}
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EmptyState from "../../components/EmptyState.astro";
---
<BaseLayout title="Bridges - Bridge Incident Registry" description="Bridge entity registry placeholder for BIR.">
  <section class="hero">
    <div class="kicker">Registry</div>
    <h1>Bridges</h1>
    <p class="lede">Bridge entity records will be listed here after canonical JSON data is added.</p>
  </section>

  <EmptyState
    title="No bridge records yet."
    message="This page reserves the bridge registry route before canonical JSON data and registry tables are added."
  />
</BaseLayout>

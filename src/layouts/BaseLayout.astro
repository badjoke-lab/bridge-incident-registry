---
import SiteMeta from "../components/SiteMeta.astro";
import "../styles/global.css";
import "../styles/components.css";

interface Props {
  title?: string;
  description?: string;
  alternateDataPath?: string;
  pageType?: "WebPage" | "CollectionPage" | "AboutPage";
  dateModified?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = "Bridge Incident Registry",
  description = "A historical registry of cross-chain bridge incidents and their aftermath.",
  alternateDataPath,
  pageType,
  dateModified,
  jsonLd
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SiteMeta
      title={title}
      description={description}
      alternateDataPath={alternateDataPath}
      pageType={pageType}
      dateModified={dateModified}
      jsonLd={jsonLd}
    />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="nav-wrap">
        <a class="brand" href="/">Bridge Incident Registry</a>
        <nav class="nav-links" aria-label="Primary navigation">
          <a href="/bridges/">Bridges</a>
          <a href="/incidents/">Incidents</a>
          <a href="/methodology/">Methodology</a>
          <a href="/about/">About</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="footer-wrap">
        <p>BIR is an informational historical registry. It does not rank bridge safety or recommend using any bridge.</p>
        <nav aria-label="Project and data navigation">
          <a href="https://badjoke-lab.com/">Hub</a>
          <span aria-hidden="true"> · </span>
          <a href="https://hei.badjoke-lab.com/">HEI</a>
          <span aria-hidden="true"> · </span>
          <a href="https://www.stableorgone.com/">SOG</a>
          <span aria-hidden="true"> · </span>
          <a href="https://cya.badjoke-lab.com/">CYA</a>
          <span aria-hidden="true"> · </span>
          <a href="https://bir.badjoke-lab.com/" aria-current="page">BIR</a>
          <span aria-hidden="true"> · </span>
          <a href="/version.json">Version</a>
          <span aria-hidden="true"> · </span>
          <a href="/data/manifest.json">Data manifest</a>
          <span aria-hidden="true"> · </span>
          <a href="/llms.txt">LLM guide</a>
          <span aria-hidden="true"> · </span>
          <a href="/ai.txt">AI guide</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
